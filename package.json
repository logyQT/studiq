{
  "name": "studiq",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @studiq/web dev",
    "build": "bun run --filter @studiq/web build",
    "start": "bun run --filter @studiq/web start",
    "clean": "npx rimraf .next node_modules/.cache coverage",
    "typecheck": "bun run --filter @studiq/web typecheck",
    "typecheck:packages": "bun run --filter @studiq/server typecheck && bun run --filter @studiq/authz typecheck && bun run --filter @studiq/ui typecheck",
    "typecheck:all": "bun run typecheck && bun run typecheck:admin && bun run typecheck:packages",
    "lint": "bun scripts/check-bun-version.ts && bun lint --no-script apps/web/src apps/admin/src packages __tests__ && bun scripts/check-import-paths.ts && bun scripts/check-migration-timestamps.ts",
    "lint:all": "bun run typecheck:all && bun run lint",
    "format": "bun scripts/check-bun-version.ts && bun fmt .",
    "format:check": "bun scripts/check-bun-version.ts && bun fmt --check .",
    "test": "vitest run",
    "test:unit": "vitest run __tests__/unit/",
    "test:integration": "vitest run __tests__/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "loadtest:seed": "bun scripts/load-test/seed.ts",
    "loadtest:bots": "bun scripts/load-test/bots.ts",
    "loadtest:reset": "bun scripts/load-test/seed.ts --reset",
    "dev:admin": "bun run --filter @studiq/admin dev",
    "build:admin": "bun run --filter @studiq/admin build",
    "start:admin": "bun run --filter @studiq/admin start",
    "lint:admin": "bun run --filter @studiq/admin lint",
    "typecheck:admin": "bun run --filter @studiq/admin typecheck",
    "dev:web": "bun run --filter @studiq/web dev",
    "build:web": "bun run --filter @studiq/web build",
    "start:web": "bun run --filter @studiq/web start",
    "lint:web": "bun run --filter @studiq/web lint",
    "typecheck:web": "bun run --filter @studiq/web typecheck"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.112",
    "@ai-sdk/openai-compatible": "^2.0.75",
    "@ai-sdk/react": "^3.0.286",
    "@studiq/server": "workspace:*",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.0",
    "@opentelemetry/api": "^1.10.0",
