{
  "name": "studiq",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "varlock run --inject vars -- bun run --filter @studiq/web build",
    "start": "varlock run --inject vars -- bun run --filter @studiq/web start",
    "clean": "npx rimraf .next node_modules/.cache coverage",
    "typecheck": "bun run --filter @studiq/web typecheck",
    "typecheck:packages": "bun run --filter @studiq/server typecheck && bun run --filter @studiq/authz typecheck && bun run --filter @studiq/ui typecheck",
    "typecheck:all": "bun check && bun run typecheck && bun run typecheck:packages",
    "lint": "bun scripts/check-bun-version.ts && bun lint --no-script apps/web/src packages __tests__ && bun scripts/check-import-paths.ts && bun scripts/check-migration-timestamps.ts && bun scripts/check-hardcoded-urls.ts && bun scripts/check-suppressions-empty.ts && bun scripts/check-env-inventory.ts",
    "lint:all": "bun run typecheck:all && bun run lint",
    "check:lockfile-age": "bun scripts/check-lockfile-age.ts",
    "env:check": "varlock load --agent",
    "env:check:quiet": "varlock load --agent >/dev/null 2>&1",
    "env:scan": "varlock scan",
    "env:status": "bun scripts/env/cli.ts status",
    "env:doctor": "bun scripts/env/cli.ts doctor",
    "env:ports": "bun scripts/env/cli.ts ports",
    "env:ensure": "bash scripts/env/varlock-run.sh ensure",
    "env:down": "bash scripts/env/varlock-run.sh down",
    "env:build": "bash scripts/env/varlock-run.sh build",
    "env:selftest": "bun scripts/env/selftest.ts",
    "env:serve": "bash scripts/env/varlock-run.sh serve",
    "env:dev": "bash scripts/env/varlock-run.sh dev",
    "env:reset-db": "bash scripts/env/varlock-run.sh reset-db",
    "env:logs": "bash scripts/env/varlock-run.sh logs",
    "env:setup": "bun scripts/env/cli.ts setup",
    "env:verify": "bun scripts/env/cli.ts verify",
    "env:supa": "bash scripts/env/varlock-run.sh supa",
    "dev:web": "bun run --filter @studiq/web dev",
    "dev:admin": "varlock run --inject vars -- bun run --filter @studiq/admin dev",
    "knip": "knip --treat-config-hints-as-errors --no-progress",
    "knip:report": "knip --reporter compact",
    "knip:files": "knip --include files,binaries --no-config-hints",
    "knip:deps": "knip --dependencies --no-config-hints",
    "knip:exports": "knip --exports --no-config-hints",
    "format": "bun scripts/check-bun-version.ts && bun fmt .",
    "format:check": "bun scripts/check-bun-version.ts && bun fmt --check .",
    "test": "vitest run __tests__/unit/ __tests__/integration",
    "test:unit": "vitest run __tests__/unit/",
    "test:integration": "varlock run --inject vars -- vitest run __tests__/integration",
    "test:admin": "vitest run __tests__/admin",
    "test:stripe": "RUN_STRIPE_TESTS=1 varlock run --inject vars -- bun x vitest run __tests__/integration/stripe-sandbox.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "varlock run --inject vars -- playwright test",
    "loadtest:seed": "varlock run --inject vars -- bun scripts/load-test/seed.ts",
    "loadtest:bots": "varlock run --inject vars -- bun scripts/load-test/bots.ts",
    "loadtest:reset": "varlock run --inject vars -- bun scripts/load-test/seed.ts --reset",
    "build:admin": "varlock run --inject vars -- bun run --filter @studiq/admin build",
    "start:admin": "varlock run --inject vars -- bun run --filter @studiq/admin start",
    "lint:admin": "bun run --filter @studiq/admin lint",
    "typecheck:admin": "bun run --filter @studiq/admin typecheck",
    "build:web": "bun run --filter @studiq/web build",
    "start:web": "bun run --filter @studiq/web start",
    "lint:web": "bun run --filter @studiq/web lint",
    "typecheck:web": "bun run --filter @studiq/web typecheck",
    "test:qa": "varlock run --inject vars -- playwright test -c __tests__/qa/playwright.qa.config.ts",
    "stripe:preflight": "varlock run --inject vars -- bun scripts/stripe-preflight.ts"
  },
  "dependencies": {
    "@studiq/server": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "ai": "^7.0.153",
    "next": "16.4.4",
    "next-intl": "^4.14.9",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "knip": "^6.44.1",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "stripe": "^23.1.0",
    "supabase": "3.0.0",
    "typescript": "^7.0.2",
    "varlock": "^1.24.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@radix-ui/react-dialog": "1.3.1",
    "katex": "^0.19.1"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.4-canary"
  }
}
