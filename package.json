    "@tiptap/starter-kit": "^3.32.0",
    "ai": "^6.0.283",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "highlight.js": "^11.12.0",
    "input-otp": "1.5.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.1",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "2.15.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "turndown": "^7.2.4",
    "unpdf": "^1.9.1",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "postcss": "8.5.31",
    "postcss-load-config": "^6.0.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "katex": "^0.19.1"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.4-canary"
  }
}
