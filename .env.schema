# StudiQ environment inventory.
#
# This file is DOCUMENTATION, not an ACL: it names every environment key the
# repository reads and records its shape, ownership and sensitivity. It never
# holds a value, and it never grants or restricts access to one. Values live in
# one root values file, `.env.local` (Git-ignored, never committed, never
# required by a gate); the `env` tool resolves this checkout's stack contract
# and exports the result to every Supabase/Next child process. No per-app values
# file is generated or read.
#
# `@defaultRequired=false` keeps `varlock load` green in a fresh checkout with
# no values file at all. `@defaultSensitive=false` means a key is only treated
# as a secret when it is explicitly marked `@sensitive` below; every other item
# is marked `@public` so the distinction is visible rather than implied.
#
# Keep this file sorted by section and value-free: an edit here is an inventory
# edit, not a configuration change.
# @defaultRequired=false
# @defaultSensitive=false
# ---

# ── Application core ─────────────────────────────────────────────────────────

# Deployment posture. Production is the default when unset; local, test and QA
# checkouts must set it explicitly (NODE_ENV cannot distinguish them).
# @type=enum(development, test, qa, production)
# @optional
# @public
APP_ENV=

# Port the web server listens on (`env:dev` and `env:serve`).
# @type=port
# @optional
# @public
APP_PORT=

# Public origin of the web app; also the root `.env.local` fallback for the site URL.
# @type=url
# @optional
# @public
APP_URL=

# Canonical public origin used for generated links, metadata and Stripe returns.
# @type=url
# @optional
# @public
NEXT_PUBLIC_SITE_URL=

# Framework build mode. Set by Next.js; never used for the payment posture.
# @type=enum(development, test, production)
# @optional
# @public
NODE_ENV=

# Next.js runtime the instrumentation hook is executing in.
# @type=enum(nodejs, edge)
# @optional
# @public
NEXT_RUNTIME=

# Disables Next.js anonymous telemetry.
# @type=enum(0,1)
# @optional
# @public
NEXT_TELEMETRY_DISABLED=

# ── Supabase ─────────────────────────────────────────────────────────────────

# Supabase API base URL (server side).
# @type=url
# @optional
# @public
SUPABASE_URL=

# Supabase API base URL exposed to the browser bundle.
# @type=url
# @optional
# @public
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key; safe to ship in the browser bundle.
# @optional
# @public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase anon key as read by server-side scripts and load tests.
# @optional
# @public
SUPABASE_ANON_KEY=

# Service-role key. Bypasses RLS: never expose it to the browser or commit it.
# @sensitive
# @optional
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string; carries the database password.
# @type=url(allowedProtocols=[postgres, postgresql])
# @sensitive
# @optional
SUPABASE_DB_URL=

# Supabase Studio URL (local stack bookkeeping).
# @type=url
# @optional
# @public
SUPABASE_STUDIO_URL=

# Mailpit URL as reported by the local Supabase stack.
# @type=url
# @optional
# @public
SUPABASE_MAIL_URL=

# Mailpit URL used by integration tests to read captured e-mail.
# @type=url
# @optional
# @public
MAILPIT_URL=

# Supabase project id passed to `supabase/config.toml`.
# @optional
# @public
SUPABASE_PROJECT_ID=

# Supabase CLI runtime backend: blank = Docker, `auto` = detect, `native` = host processes.
# @optional
# @public
SUPABASE_RUNTIME=

# Opt into the experimental per-worktree `supabase stack` backend (0/1).
# @type=enum(0,1)
# @optional
# @public
SUPABASE_EXPERIMENTAL_STACK=

# Native stack state/artifact directory (absolute path outside the checkout).
# @optional
# @public
SUPABASE_HOME=

# Working directory the Supabase CLI resolves stacks against (`--workdir`).
# Only this checkout's root is accepted by `env:supa` stop/restart guards.
# @optional
# @public
SUPABASE_WORKDIR=

# OS user the native Postgres process runs as when the stack is started as root.
# @optional
# @public
SUPABASE_NATIVE_POSTGRES_USER=

# Named stack inside this checkout; blank means the branch's default stack.
# @optional
# @public
SUPABASE_STACK=

# Comma-separated `supabase stack start -x` capabilities to skip (empty = full).
# @optional
# @public
SUPABASE_START_EXCLUDE=

# Reuse a stack owned by another checkout instead of starting one here (0/1).
# @type=enum(0,1)
# @optional
# @public
SUPABASE_SHARED=

# Free-form label naming the checkout that owns the shared stack.
# @optional
# @public
SUPABASE_SHARED_OWNER=

# Base port for the fixed-port (non-stack) Supabase layout.
# @type=port
# @optional
# @public
SUPABASE_PORT_BASE=

# Fixed Supabase API port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_API_PORT=

# Fixed Supabase database port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_DB_PORT=

# Fixed Supabase Studio port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_STUDIO_PORT=

# Fixed Mailpit HTTP port (legacy non-stack layout; stack mode discovers it).
# @type=port
# @optional
# @public
SUPABASE_MAIL_PORT=

# Mailpit HTTP port override passed to `supabase stack start`.
# @type=port
# @optional
# @public
SUPABASE_LOCAL_SMTP_PORT=

# Mailpit SMTP port override for `supabase stack start`.
# @type=port
# @optional
# @public
SUPABASE_LOCAL_SMTP_SMTP_PORT=

# Mailpit POP3 port override for `supabase stack start`.
# @type=port
# @optional
# @public
SUPABASE_LOCAL_SMTP_POP3_PORT=

# Fixed Realtime RPC port (non-stack/CI layout).
# In shared mode, `env:ensure --realtime` probes readiness against this port:
# set it to the shared stack's published Realtime RPC port. It is the variable
# `sharedProbeContext` reads; unset keeps it 0, so the probe fails rather than
# probing an arbitrary port.
# @type=port
# @optional
# @public
SUPABASE_REALTIME_PORT=

# Fixed analytics port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_ANALYTICS_PORT=

# Fixed edge-function inspector port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_EDGE_INSPECTOR_PORT=

# Fixed shadow database port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_SHADOW_PORT=

# Fixed connection-pooler port (non-stack/CI layout).
# @type=port
# @optional
# @public
SUPABASE_POOLER_PORT=

# Temporary auth-e-mail template workaround: recovery template path injected in CI.
# @optional
# @public
SUPABASE_AUTH_EMAIL_TEMPLATE_RECOVERY_CONTENT_PATH=

# Temporary auth-e-mail template workaround: confirmation template path injected in CI.
# @optional
# @public
SUPABASE_AUTH_EMAIL_TEMPLATE_CONFIRMATION_CONTENT_PATH=

# Stack identity/runtime labels emitted by the `env` tool for `env:status`;
# generated, read-only bookkeeping, never set by hand.
# @optional
# @public
SUPABASE_STACK_ID=

# @optional
# @public
SUPABASE_STACK_NAME=

# @optional
# @public
SUPABASE_STACK_BRANCH=

# @optional
# @public
SUPABASE_STACK_RUNTIME=

# @optional
# @public
SUPABASE_STACK_CONFIG_DRIFT=

# ── Local dev / build helpers ────────────────────────────────────────────────

# Cross-checkout runtime registry (build lock, ownership, app-port lease).
# @optional
# @public
STUDIQ_DEV_REGISTRY=

# Override this checkout's `.dev/` state directory (tests/isolated runs only).
# @optional
# @public
STUDIQ_ENV_STATE_DIR=

# Optional primary-checkout vault pointer resolved by the `env` wrapper;
# defaults to `<primary>/.env.vault` (first `git worktree list` entry). Opt-in
# provider refs only (LLM/Stripe); `.env.local` remains the only required values
# file. Never a value.
# @optional
# @public
STUDIQ_ENV_VAULT=

# Set to 1 by the `env` tool so seeders verify they target this checkout's stack.
# @type=enum(0,1)
# @optional
# @public
STUDIQ_STACK_MODE=

# Heap cap (MB) for `bun run env:build`.
# @type=number
# @optional
# @public
DEV_BUILD_MEMORY_MB=

# Output directory for load-test account pools and reports.
# @optional
# @public
LOADTEST_DIR=

# E-mail domain used for seeded load-test accounts.
# @optional
# @public
LOADTEST_EMAIL_DOMAIN=

# Password assigned to every seeded load-test account.
# @sensitive
# @optional
LOADTEST_PASSWORD=

# ── Payments ─────────────────────────────────────────────────────────────────

# Payment driver: `mock` is allowed outside production only.
# @type=enum(mock, stripe)
# @optional
# @public
PAYMENT_DRIVER=

# Stripe API key (secret or restricted, test or live mode). Restricted keys are preferred.
# @sensitive
# @optional
STRIPE_SECRET_KEY=

# Stripe webhook signing secret.
# @sensitive
# @optional
STRIPE_WEBHOOK_SECRET=

# Stripe Billing Portal configuration id (`bpc_...`) created by the bootstrap script.
# @type=string(startsWith=bpc_)
# @optional
# @public
STRIPE_PORTAL_CONFIGURATION_ID=

# Managed Payments product tax code (`txcd_...`), bootstrap-only.
# @type=string(startsWith=txcd_)
# @optional
# @public
STRIPE_PRODUCT_TAX_CODE=

# Explicit human confirmation that the tax code is Managed-Payments eligible.
# @type=enum(0,1)
# @optional
# @public
STRIPE_PRODUCT_TAX_CODE_CONFIRMED=

# Escape hatch permitting a live Stripe key outside production.
# @type=enum(0,1)
# @optional
# @public
STRIPE_ALLOW_LIVE=

# Incident switch that stops NEW checkout sessions (webhooks/portal keep working).
# @type=boolean
# @optional
# @public
CHECKOUT_KILL_SWITCH=

# ── Mail ─────────────────────────────────────────────────────────────────────

# Mail adapter: `none` (default), `log` (development only) or `smtp`.
# @type=enum(none, log, smtp)
# @optional
# @public
MAIL_DRIVER=

# From address used by the SMTP adapter.
# @optional
# @public
MAIL_FROM=

# SMTP server hostname.
# @optional
# @public
MAIL_SMTP_HOST=

# SMTP server port.
# @type=port
# @optional
# @public
MAIL_SMTP_PORT=

# Use implicit TLS for SMTP.
# @type=boolean
# @optional
# @public
MAIL_SMTP_SECURE=

# SMTP username; must be set together with MAIL_SMTP_PASS.
# @optional
# @public
MAIL_SMTP_USER=

# SMTP password.
# @sensitive
# @optional
MAIL_SMTP_PASS=

# ── LLM / agent ──────────────────────────────────────────────────────────────

# LLM provider id used by the AI SDK model factory.
# @optional
# @public
LLM_PROVIDER=

# LLM provider API key.
# @sensitive
# @optional
LLM_API_KEY=

# Model id the AI features call.
# @optional
# @public
LLM_MODEL_NAME=

# Provider base URL override.
# @type=url
# @optional
# @public
LLM_BASE_URL=

# Optional reasoning-effort hint for reasoning-capable models.
# @optional
# @public
LLM_REASONING_EFFORT=

# ── Telemetry ────────────────────────────────────────────────────────────────

# Disable the OpenTelemetry SDK entirely (unit tests set this).
# @type=boolean
# @optional
# @public
OTEL_SDK_DISABLED=

# `service.name` resource attribute for traces, metrics and logs.
# @optional
# @public
OTEL_SERVICE_NAME=

# OTLP collector endpoint the SDK exports to.
# @type=url
# @optional
# @public
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── CI / E2E / QA ────────────────────────────────────────────────────────────

# Workflow-internal: pinned Bun toolchain installed by `verify.yml` (not app config).
# @type=string
# @optional
# @public
BUN_VERSION=

# Workflow-internal: the PR base ref the `scope` job diffs against.
# @type=string
# @optional
# @public
BASE_REF=

# Set by GitHub Actions (`true`) or by this workflow's job-level `env:` (`1`);
# consumers only test truthiness, so a string preserves whichever literal CI sends.
# @type=string
# @optional
# @public
CI=

# E2E: reuse already-seeded tenants instead of seeding.
# @type=enum(0,1)
# @optional
# @public
E2E_SKIP_SEED=

# E2E: the workflow owns the app server, so Playwright must not start one.
# @type=enum(0,1)
# @optional
# @public
E2E_SKIP_WEB_WS=

# E2E: worker count override.
# @type=number
# @optional
# @public
E2E_WORKERS=

# E2E: opt WebKit into the project matrix.
# @type=enum(0,1)
# @optional
# @public
E2E_INCLUDE_WEBKIT=

# E2E: tenant-seed concurrency.
# @type=number
# @optional
# @public
E2E_SEED_CONCURRENCY=

# QA: base URL of the deployed QA app.
# @type=url
# @optional
# @public
QA_APP_URL=

# QA: Mailpit URL used by the QA suite.
# @type=url
# @optional
# @public
QA_MAIL_URL=

# QA: worker count override (CI uses 4).
# @type=number
# @optional
# @public
QA_WORKERS=

# QA: run id folded into tenant keys so a run can be replayed.
# @optional
# @public
QA_RUN_SUFFIX=

# QA: Supabase URL the suite runs against.
# @type=url
# @optional
# @public
QA_SUPABASE_URL=

# QA: anon key for the suite's Supabase target.
# @optional
# @public
QA_SUPABASE_ANON_KEY=

# QA: service-role key for the suite's Supabase target.
# @sensitive
# @optional
QA_SUPABASE_SERVICE_ROLE_KEY=

# QA: tenant-seed concurrency.
# @type=number
# @optional
# @public
QA_SEED_CONCURRENCY=

# Opt into the Stripe sandbox integration test (requires STRIPE_SECRET_KEY).
# @type=enum(0,1)
# @optional
# @public
RUN_STRIPE_TESTS=
