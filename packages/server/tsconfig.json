{
  "extends": "../tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@studiq/authz": ["../../packages/authz/src/index.ts"],
      "@studiq/authz/*": ["../../packages/authz/src/*"],
      "@studiq/server": ["./src/index.ts"],
      "@studiq/server/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
