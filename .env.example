# ─────────────────────────────────────────────────────────────────────────────
# StudiQ local-stack contract
#
#   cp .env.example .env
#
# This is the ONLY hand-edited env file. `scripts/dev` resolves the rest, exports
# it to every Supabase/Next call, and renders:
#   * `apps/web/.env`      — generated, mode 600, Git-ignored, never edit
#   * `supabase/.env`      — generated, Git-ignored, so plain `bunx supabase ...`
#                            in this checkout targets THIS checkout's stack
#
# Every value is optional. With an empty/absent value `scripts/dev` derives a
# per-checkout default from the checkout path, so two worktrees never collide.
# For parallel agents/developers, set APP_PORT, SUPABASE_PROJECT_ID and
# SUPABASE_PORT_BASE explicitly (see the examples at the bottom).
# ─────────────────────────────────────────────────────────────────────────────

# ── Web ──────────────────────────────────────────────────────────────────────
# Port the web server listens on (`dev` and `prod` modes).
APP_PORT=3000
# Derived from APP_PORT unless set explicitly.
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase identity ────────────────────────────────────────────────────────
# Blank/absent = derive from this checkout's path (basename + path hash), e.g.
# `studiq-lucky-squid-1a2b3c4d`. Set it explicitly only when another checkout
# already uses the derived id (or to pin a well-known name).
# Leave it commented when you rely on derivation: an empty `SUPABASE_PROJECT_ID=`
# would shadow the generated `supabase/.env`, which is what makes plain
# `bunx supabase ...` follow this checkout outside `bun dev:*`.
# SUPABASE_PROJECT_ID=

# ── Supabase ports ───────────────────────────────────────────────────────────
# One block per checkout: API=+1, DB=+2, Studio=+3, Mail=+4, Analytics=+7,
# Edge inspector=+8, Pooler=+9, Shadow=+0.
SUPABASE_PORT_BASE=54320
# Explicit per-port overrides (rarely needed; they win over the base):
# SUPABASE_API_PORT=54321
# SUPABASE_DB_PORT=54322
# SUPABASE_STUDIO_PORT=54323
# SUPABASE_MAIL_PORT=54324
# SUPABASE_ANALYTICS_PORT=54327
# SUPABASE_EDGE_INSPECTOR_PORT=54328
# SUPABASE_SHADOW_PORT=54320
# SUPABASE_POOLER_PORT=54329

# Derived from SUPABASE_API_PORT for a local stack; set explicitly only for a
# shared/remote stack (SUPABASE_SHARED=1).
# SUPABASE_URL=http://localhost:54321

# Generated from `supabase status -o env`; set only for a shared/remote DB.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Shared stack mode (reuse a stack without owning it) ──────────────────────
# 1 = run the app/tests against a stack another checkout owns. `dev:up` never
# starts Supabase; `dev:down --all`, `dev:reset-db` and `supabase stop` are
# refused. Requires SUPABASE_URL + the anon/service keys above.
SUPABASE_SHARED=0
# Free-form label shown by `bun dev:status` / `bun dev:doctor`.
# SUPABASE_SHARED_OWNER=another-checkout

# ── Runtime registry ─────────────────────────────────────────────────────────
# Where `scripts/dev` records which checkout owns which project id/ports, so a
# collision names the owner instead of silently reusing/killing their stack.
# Blank = ${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/studiq-dev-$(id -u).
# STUDIQ_DEV_REGISTRY=

# ── Lean local stack ─────────────────────────────────────────────────────────
# Comma-separated `supabase start -x` list. The app uses none of these locally:
# no realtime subscriptions, no edge functions, no analytics/vector, no image
# transforms, no pooler. Skipping them saves RAM and startup time on a shared
# box. Set it empty (SUPABASE_START_EXCLUDE=) to start the full stack when you
# are deliberately debugging one of them.
SUPABASE_START_EXCLUDE=realtime,edge-runtime,imgproxy,logflare,vector,supavisor

# ── Agent build/serve ────────────────────────────────────────────────────────
# Heap cap for `bun dev:build` (agents build on constrained machines).
DEV_BUILD_MEMORY_MB=4096

# ── Telemetry (optional) ─────────────────────────────────────────────────────
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=studiq-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─────────────────────────────────────────────────────────────────────────────
# Examples — parallel checkouts on one machine
# ─────────────────────────────────────────────────────────────────────────────
# Checkout A
#   APP_PORT=3000
#   SUPABASE_PROJECT_ID=studiq-agent-a
#   SUPABASE_PORT_BASE=54320
#
# Checkout B
#   APP_PORT=3001
#   SUPABASE_PROJECT_ID=studiq-agent-b
#   SUPABASE_PORT_BASE=54420
#
# Checkout C — shared mode, reusing checkout A's stack (no local Supabase):
#   APP_PORT=3002
#   SUPABASE_SHARED=1
#   SUPABASE_SHARED_OWNER=studiq-agent-a
#   SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<copy from checkout A apps/web/.env>
#   SUPABASE_SERVICE_ROLE_KEY=<copy from checkout A apps/web/.env>
