# Web
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments (#662). `mock` is the default and needs no Stripe configuration.
# `stripe` requires a test-mode key, the webhook signing secret and the portal
# configuration id created by `scripts/stripe-bootstrap.ts`. Never commit keys.
PAYMENT_DRIVER=mock
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...

# Supabase (local defaults)
SUPABASE_URL=http://localhost:54321
# Generated by `bun dev:up` from `supabase status`; set these only for a remote DB.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Telemetry (optional)
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=studiq-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
