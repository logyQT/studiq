# ─────────────────────────────────────────────────────────────────────────────
# StudiQ local-stack contract
#
#   cp .env.example .env
#
# This is the ONLY hand-edited env file. `scripts/dev` reads it, exports the
# resolved values to every Supabase/Next call, and renders:
#   * `apps/web/.env`      — generated, mode 600, Git-ignored, never edit
#   * `supabase/.env`      — generated, Git-ignored, so plain `bunx supabase ...`
#                            in this checkout can parse `config.toml`
#
# Local mode uses the experimental `supabase stack` backend
# (`[experimental] stack = true`). The CLI assigns ports from 20000-32767 and
# keeps each local project separate:
#
#   identity = project root + current git branch + optional SUPABASE_STACK name
#
# So every git worktree/branch gets its own database and ports. Only APP_PORT
# can collide between checkouts; pick a different one per worktree (or let
# `bun dev:ports` print a free port). A branch switch creates/resumes a separate
# stack; moving/renaming the checkout creates a new one. `bun dev:down --all`
# stops the stack and keeps its data; `bunx supabase stack destroy` (add
# `--stack "$SUPABASE_STACK"` for a named stack) deletes it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web ──────────────────────────────────────────────────────────────────────
# Port the web server listens on (`dev` and `prod` modes).
APP_PORT=3000
# Derived from APP_PORT unless set explicitly.
# APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Named local stack (optional) ─────────────────────────────────────────────
# A second, independent stack in the same checkout (for example dev + test):
#   bun dev:up   → default stack for this branch
#   SUPABASE_STACK=test bun dev:up
# Leave blank to use the branch's default stack. The name is part of the
# stack identity; `bun dev:down --all` stops the one selected here.
# SUPABASE_STACK=

# ── Stack runtime (spike) ────────────────────────────────────────────────────
# blank  = Docker (the pre-spike default; fails if Docker is unreachable).
# auto   = the CLI picks Docker, then Podman, then native.
# native = run every service as a host process, no Docker daemon.
# The choice is persisted per stack when the stack is created; switching an
# existing stack requires destroying it first (data is deleted):
#   bunx supabase stack destroy --stack "$SUPABASE_STACK" --yes
# Native data lives in ~/.supabase/stacks/<id>/; artifacts are cached in
# ~/.supabase/cache/stack and survive `stack destroy`.
# SUPABASE_RUNTIME=native
# Optional: absolute path outside the checkout for native state/artifacts.
# SUPABASE_HOME=/var/tmp/studiq-supabase
# Only needed when starting the native stack as root (Postgres cannot run as root).
# SUPABASE_NATIVE_POSTGRES_USER=postgres

# ── Lean local stack ─────────────────────────────────────────────────────────
# Comma-separated `supabase stack start -x` capabilities. The app uses none of
# these locally: no realtime subscriptions, no edge functions, no analytics,
# no pooler. Set it empty (SUPABASE_START_EXCLUDE=) for the full stack.
# Changes apply on the next start: `bun dev:down --all`, then `bun dev:up`.
SUPABASE_START_EXCLUDE=realtime,functions,analytics,pooler

# ── Shared stack mode (reuse a stack without owning it) ──────────────────────
# 1 = run the app/tests against a stack another checkout owns (the shared QA
# stack keeps its fixed ports). `dev:up` never starts Supabase;
# `dev:down --all`, `dev:reset-db` and `supabase stop` are refused.
# Requires SUPABASE_URL + the anon/service keys below.
SUPABASE_SHARED=0
# Free-form label shown by `bun dev:status` / `bun dev:doctor`.
# SUPABASE_SHARED_OWNER=another-checkout

# Explicit URLs/keys — shared/remote stacks only. Local stack mode discovers
# them from `supabase status` and ignores these values.
# SUPABASE_URL=http://localhost:54321
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
# SUPABASE_MAIL_URL=http://localhost:54324
# SUPABASE_STUDIO_URL=http://localhost:54323
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Runtime registry ─────────────────────────────────────────────────────────
# Build-lock (and shared-mode ownership) state outside the repo.
# Blank = ${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/studiq-dev-$(id -u).
# Must be a private directory owned by you; `scripts/dev` refuses a symlink or
# an existing directory it does not own (and enforces mode 700).
# STUDIQ_DEV_REGISTRY=

# ── Agent build/serve ────────────────────────────────────────────────────────
# Heap cap for `bun dev:build` (agents build on constrained machines).
DEV_BUILD_MEMORY_MB=4096

# ── Telemetry (optional) ─────────────────────────────────────────────────────
OTEL_SDK_DISABLED=true
OTEL_SERVICE_NAME=studiq-dev
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─────────────────────────────────────────────────────────────────────────────
# Examples — parallel checkouts on one machine
# ─────────────────────────────────────────────────────────────────────────────
# Checkout A (branch `feat/a`): own stack + ports automatically
#   APP_PORT=3000
#
# Checkout B (branch `feat/b`, separate worktree): own stack + ports
#   APP_PORT=3001
#
# Same checkout, two stacks (e.g. dev and a destructive test run)
#   APP_PORT=3002
#   SUPABASE_STACK=test
#
# Checkout C — shared mode, reusing another checkout's stack (no local Supabase):
#   APP_PORT=3003
#   SUPABASE_SHARED=1
#   SUPABASE_SHARED_OWNER=studiq-agent-a
#   SUPABASE_URL=http://localhost:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<copy from the owning checkout's apps/web/.env>
#   SUPABASE_SERVICE_ROLE_KEY=<copy from the owning checkout's apps/web/.env>
