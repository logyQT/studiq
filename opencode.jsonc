{
  "$schema": "https://opencode.ai/config.json",
  // Abort tool calls that stop making progress so a stuck Code Mode promise
  // can't stall an unattended run. See plugins/tool-watchdog/README.md.
  "plugins": ["./plugins/tool-watchdog"],
  // Local observability stack tooling. `grafana/mcp-grafana` exposes Tempo
  // (traces), Loki (logs) and Prometheus (metrics) as agent tools, with
  // trace↔log correlation. See docs/observability-debugging.md.
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": ["mcp-grafana", "-t", "stdio"],
        "environment": {
          "GRAFANA_URL": "http://localhost:3001",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_SERVICE_ACCOUNT_TOKEN}"
        }
      }
    }
  }
}
