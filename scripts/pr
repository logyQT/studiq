#!/usr/bin/env bash
# Push the current branch and open a pull request for it. It is safe to run again:
# when the branch has an open pull request, the script prints its URL.
#
# Usage:
#   scripts/pr                            # title and body from the commits (gh --fill)
#   scripts/pr "fix: resolve login bug"   # set the title
#   scripts/pr --body-file <file>         # read the body from a file ("-" is stdin)
#   scripts/pr --base feat/parent         # use a base branch other than main
#   scripts/pr --draft                    # open a draft
#
# Requires: gh (GitHub CLI, authenticated)

set -euo pipefail

fail() { printf '✘ %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: scripts/pr [title] [--base <branch>] [--body-file <file>] [--draft]

  [title]             PR title (default: gh --fill takes it from the commits)
  --base <branch>     Branch to merge into (default: main)
  --body-file <file>  Read the PR body from a file, or from stdin with "-"
                      (default: gh --fill takes it from the commits)
  --draft, -d         Create as draft PR

The script pushes the current branch to origin before it creates the PR.
EOF
}

BASE_BRANCH="main"
BODY_FILE=""
TITLE=""
DRAFT=false

# Parse before anything else, so a wrong command stops with no side effect.
while [ $# -gt 0 ]; do
  case "$1" in
    --draft|-d) DRAFT=true; shift ;;
    --base)
      [ -n "${2:-}" ] || fail "--base requires a branch name"
      BASE_BRANCH="$2"; shift 2 ;;
    --body-file)
      [ -n "${2:-}" ] || fail "--body-file requires a file, or - for stdin"
      BODY_FILE="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    # Without this arm, a mistyped or removed flag would become the PR title.
    -*) fail "Unknown option '$1'. Run scripts/pr --help." ;;
    *)
      [ -z "$TITLE" ] || fail "Give one title only. Quote a title that contains spaces."
      TITLE="$1"; shift ;;
  esac
done

# ── Preflight checks ───────────────────────────────────────────
command -v gh >/dev/null 2>&1 || fail "GitHub CLI (gh) not installed. Install: https://cli.github.com/"
gh auth status >/dev/null 2>&1 || fail "Not authenticated. Run: gh auth login"

git rev-parse --show-toplevel >/dev/null 2>&1 || fail "Not inside a git repository"
CURRENT_BRANCH=$(git branch --show-current)
[ -n "$CURRENT_BRANCH" ] || fail "Not on a branch (detached HEAD)"
# The push below would publish local commits straight to these branches.
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "$BASE_BRANCH" ]; then
  fail "You are on '$CURRENT_BRANCH'. Switch to the branch of the pull request."
fi

# No `cd`: a relative --body-file path is relative to where the caller runs this.
if [ -n "$BODY_FILE" ] && [ "$BODY_FILE" != "-" ]; then
  [ -f "$BODY_FILE" ] && [ -r "$BODY_FILE" ] || fail "Cannot read body file '$BODY_FILE'"
fi

# ── Resolve the base ───────────────────────────────────────────
# gh resolves --base against the base repository, never your local refs, so a
# local-only branch cannot be a PR base. Fetch first, then look at
# origin/<base>, the ref GitHub will use.
git fetch origin "$BASE_BRANCH" --quiet 2>/dev/null || true
if ! git rev-parse --verify --quiet "refs/remotes/origin/$BASE_BRANCH^{commit}" >/dev/null; then
  fail "Base branch '$BASE_BRANCH' is not on origin, so it cannot be a PR base.
  Push it first:  git push -u origin '$BASE_BRANCH'
  Pass the branch name as it exists on origin; a local-only branch or an
  origin/<branch> ref will not do."
fi

# ── Push ───────────────────────────────────────────────────────
# Every time: a branch that is already on origin can still be behind this checkout.
# Hook and git output goes to stderr, so stdout carries only the PR URL.
git push -u origin "$CURRENT_BRANCH" >&2 \
  || fail "Could not push '$CURRENT_BRANCH'. No pull request was created."

# ── Existing pull request ──────────────────────────────────────
EXISTING_URL=$(gh pr list --head "$CURRENT_BRANCH" --state open --json url -q '.[0].url // empty') \
  || fail "Could not check for an existing pull request"
if [ -n "$EXISTING_URL" ]; then
  printf 'This branch has an open pull request. It is not changed.\n' >&2
  printf '%s\n' "$EXISTING_URL"
  exit 0
fi

# ── Create ─────────────────────────────────────────────────────
# --fill supplies the title and body; an explicit --title or --body-file wins.
ARGS=(--base "$BASE_BRANCH" --head "$CURRENT_BRANCH" --fill)
[ -z "$TITLE" ] || ARGS+=(--title "$TITLE")
[ -z "$BODY_FILE" ] || ARGS+=(--body-file "$BODY_FILE")
[ "$DRAFT" = false ] || ARGS+=(--draft)

gh pr create "${ARGS[@]}"
