#!/usr/bin/env bash
# Create a git worktree on a new feature branch for isolated agent work.
#
# Usage:
#   scripts/spin feat/my-feature          # create branch + worktree
#   scripts/spin feat/my-feature --clean  # remove worktree + branch
#   scripts/spin --list                   # list all worktrees
#
# The worktree is created as a sibling of the repository, named after the
# repository directory and the branch (slashes become dashes):
#   ../studiq-feat-my-feature/
#
# `.worktrees/` inside the repo is reserved for the QA environments
# (`qa-env-N`) and is never used by this script.
#
# After creating, move your OpenCode session into the worktree:
#   /session-move <worktree-path>

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { printf "${GREEN}✔${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}⚠${NC} %s\n" "$*"; }
fail()  { printf "${RED}✘${NC} %s\n" "$*" >&2; exit 1; }
header(){ printf "\n${CYAN}▸${NC} %s\n" "$*"; }

# ── Ensure we're in a git repo ─────────────────────────────────
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || fail "Not inside a git repository"
REPO_NAME=$(basename "$REPO_ROOT")
REPO_PARENT=$(dirname "$REPO_ROOT")

# ── Helpers ────────────────────────────────────────────────────
# feat/my-feature → feat-my-feature
branch_slug() { printf '%s' "${1//\//-}"; }

# Print the path of the worktree checked out for a branch, if any.
worktree_path_for_branch() {
  git -C "$REPO_ROOT" worktree list --porcelain 2>/dev/null | awk -v ref="refs/heads/$1" '
    /^worktree / { path = substr($0, 10) }
    /^branch /   { if ($2 == ref) { print path; exit } }
  '
}

# ── Parse flags ────────────────────────────────────────────────
case "${1:-}" in
  --list|-l)
    header "Active worktrees"
    git -C "$REPO_ROOT" worktree list
    exit 0
    ;;
  --help|-h)
    echo "Usage: scripts/spin <branch-name> [--clean]"
    echo "       scripts/spin --list"
    echo ""
    echo "  <branch-name>   Feature branch name (e.g. feat/my-feature)"
    echo "  --clean         Remove the worktree and delete the branch"
    echo "  --list, -l      List all worktrees"
    echo ""
    echo "Worktrees are created beside the repo, named after the repo and branch:"
    echo "  ../${REPO_NAME}-feat-my-feature"
    echo ""
    echo "'.worktrees/' inside the repo is reserved for the QA environments (qa-env-N)."
    exit 0
    ;;
  "") fail "Missing branch name. Usage: scripts/spin <branch-name>" ;;
esac

BRANCH="$1"
CLEAN=false
[[ "${2:-}" == "--clean" ]] && CLEAN=true

# ── Derive worktree path ───────────────────────────────────────
# Worktrees live beside the repo: ../<repo>-<branch-with-dashes>
# feat/my-feature → ../studiq-feat-my-feature
BRANCH_SLUG=$(branch_slug "$BRANCH")
WORKTREE_ROOT="$REPO_PARENT"
WORKTREE_PATH="${WORKTREE_ROOT}/${REPO_NAME}-${BRANCH_SLUG}"

# Older versions of this script nested worktrees under .worktrees/<branch>.
LEGACY_WORKTREE_PATH="${REPO_ROOT}/.worktrees/${BRANCH}"

# ── Clean mode ─────────────────────────────────────────────────
if $CLEAN; then
  header "Cleaning up worktree for '$BRANCH'"

  REGISTERED_PATH="$(worktree_path_for_branch "$BRANCH" || true)"

  if [ -n "$REGISTERED_PATH" ]; then
    if [ "$REGISTERED_PATH" = "$REPO_ROOT" ]; then
      fail "Refusing to remove the main checkout: $REPO_ROOT"
    fi

    if [ "$REGISTERED_PATH" = "$LEGACY_WORKTREE_PATH" ]; then
      warn "Found a legacy nested worktree: $LEGACY_WORKTREE_PATH"
      warn "scripts/spin now creates worktrees beside the repo: $WORKTREE_PATH"
    elif [ "$REGISTERED_PATH" != "$WORKTREE_PATH" ]; then
      warn "Worktree for '$BRANCH' is not at the expected path: $REGISTERED_PATH"
    fi

    if [ ! -d "$REGISTERED_PATH" ]; then
      warn "Worktree directory is missing: $REGISTERED_PATH (pruning stale metadata)"
    elif git -C "$REPO_ROOT" worktree remove "$REGISTERED_PATH" --force 2>/dev/null; then
      info "Removed worktree: $REGISTERED_PATH"
    else
      fail "Could not remove worktree: $REGISTERED_PATH"
    fi
  elif [ -d "$LEGACY_WORKTREE_PATH" ]; then
    warn "Found a legacy directory that is not a registered worktree: $LEGACY_WORKTREE_PATH"
    warn "Left it untouched. Remove it manually, then re-run this command:"
    echo "    rm -rf \"$LEGACY_WORKTREE_PATH\""
  elif [ -d "$WORKTREE_PATH" ]; then
    warn "Found a directory that is not a registered worktree: $WORKTREE_PATH"
    warn "Left it untouched. Remove it manually, then re-run this command:"
    echo "    rm -rf \"$WORKTREE_PATH\""
  else
    warn "No worktree found for '$BRANCH' (expected $WORKTREE_PATH)"
  fi

  # Delete the branch if it exists
  if git -C "$REPO_ROOT" branch --list "$BRANCH" | grep -q .; then
    git -C "$REPO_ROOT" branch -D "$BRANCH" 2>/dev/null \
      && info "Deleted branch: $BRANCH" \
      || warn "Could not delete branch (may have unmerged changes)"
  else
    warn "Branch '$BRANCH' does not exist"
  fi

  # Cleanup stale worktree metadata
  git -C "$REPO_ROOT" worktree prune 2>/dev/null && info "Pruned stale worktree entries"
  exit 0
fi

# ── Check branch doesn't already exist ─────────────────────────
if git -C "$REPO_ROOT" branch --list "$BRANCH" | grep -q .; then
  fail "Branch '$BRANCH' already exists. Use it directly or pick a different name."
fi

# ── Check the derived path doesn't collide with another branch ─
while IFS= read -r existing; do
  [ -n "$existing" ] || continue
  if [ "$(branch_slug "$existing")" = "$BRANCH_SLUG" ]; then
    fail "Branch '$existing' maps to the same worktree directory as '$BRANCH': $WORKTREE_PATH. Rename one of them (e.g. avoid mixing 'feat/x' and 'feat-x')."
  fi
done < <(git -C "$REPO_ROOT" for-each-ref --format='%(refname:short)' refs/heads/)

# ── Check worktree path doesn't already exist ──────────────────
if [ -e "$WORKTREE_PATH" ]; then
  fail "Directory already exists: $WORKTREE_PATH. Remove it or pick a different branch name."
fi

# ── Create branch + worktree ───────────────────────────────────
header "Creating branch '$BRANCH' from main"
git -C "$REPO_ROOT" branch "$BRANCH" main 2>/dev/null \
  || fail "Could not create branch '$BRANCH'"
info "Created branch '$BRANCH'"

header "Creating worktree"
git -C "$REPO_ROOT" worktree add "$WORKTREE_PATH" "$BRANCH" 2>/dev/null \
  || fail "Could not create worktree at $WORKTREE_PATH"
info "Worktree ready at $WORKTREE_PATH"

# ── Summary ────────────────────────────────────────────────────
header "Done"
echo ""
printf "  Branch:   ${CYAN}%s${NC}\n" "$BRANCH"
printf "  Worktree: ${CYAN}%s${NC}\n" "$WORKTREE_PATH"
echo ""
echo "  Next steps:"
echo "    1. cd \"$WORKTREE_PATH\""
echo "    2. Open an agent session in the worktree"
echo "    3. When done: scripts/spin $BRANCH --clean"
echo ""
