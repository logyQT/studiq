#!/usr/bin/env bash
# Create a git worktree on a new feature branch for isolated agent work.
#
# Usage:
#   scripts/spin feat/my-feature              # create branch + worktree (bun install)
#   scripts/spin feat/my-feature --no-install # create without installing deps
#   scripts/spin feat/my-feature --no-seed-cache
#                                             # create without seeding .next/cache
#   scripts/spin feat/my-feature --clean      # remove worktree + branch
#   scripts/spin --list                       # list all worktrees
#
# The worktree is created directly in the checkout's parent directory, one
# directory per branch, with '/' flattened to '-' so the path stays one level
# deep:
#   ../feat-my-feature/   (branch feat/my-feature)
#   ../fix-login-bug/     (branch fix/login-bug)
#
# SPIN_WORKTREE_ROOT=<absolute dir> relocates that root (same flattening), e.g.
# SPIN_WORKTREE_ROOT=/tmp/builds → /tmp/builds/feat-my-feature.
#
# The branch is cut from a freshly fetched origin/main (falling back to the
# last fetched origin/main, then local main) and the base commit it was cut
# from is written to <worktree>/.spin-base (git-ignored).
#
# After creating, move your OpenCode session into the worktree:
#   /session-move <worktree-path>

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { printf "${GREEN}✔${NC} %s\n" "$*"; }
warn()  { printf "${YELLOW}⚠${NC} %s\n" "$*"; }
fail()  { printf "${RED}✘${NC} %s\n" "$*" >&2; exit 1; }
header(){ printf "\n${CYAN}▸${NC} %s\n" "$*"; }

# Git prints the remote URL in fetch failures; a remote configured with an
# embedded token would otherwise leak it into session logs.
redact_remote_error() {
  printf '%s\n' "${1%%$'\n'*}" | sed -E 's#(https?://)[^/@[:space:]]+@#\1***@#g'
}

# Lock reason recorded on every worktree this script creates. Cleanup requires
# it, so a path match alone cannot authorize removing someone else's worktree.
PROVENANCE_REASON="created-by-scripts/spin"

# ── Ensure we're in a git repo ─────────────────────────────────
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || fail "Not inside a git repository"

# ── Helpers ────────────────────────────────────────────────────
# Print the path of the primary checkout (the first worktree entry).
primary_checkout_path() {
  local record
  while IFS= read -r -d '' record; do
    case "$record" in
      "worktree "*) printf '%s\n' "${record#worktree }"; return 0 ;;
    esac
  done < <(git -C "$REPO_ROOT" worktree list --porcelain -z)
  return 0
}

# Print the path of the worktree checked out for a branch, if any.
# Parses the NUL-delimited form so paths are never C-quoted or split on
# embedded newlines.
worktree_path_for_branch() {
  local record path=""
  while IFS= read -r -d '' record; do
    case "$record" in
      "worktree "*) path="${record#worktree }" ;;
      *) if [ "$record" = "branch refs/heads/$1" ]; then printf '%s\n' "$path"; return 0; fi ;;
    esac
  done < <(git -C "$REPO_ROOT" worktree list --porcelain -z)
  return 0
}

# Succeed when git has a worktree registration at a path, on a branch or not.
worktree_registered_at_path() {
  local want="$1" record
  while IFS= read -r -d '' record; do
    if [ "$record" = "worktree $want" ]; then return 0; fi
  done < <(git -C "$REPO_ROOT" worktree list --porcelain -z)
  return 1
}

# Print the branch checked out at a worktree path, if any.
worktree_branch_at_path() {
  local want="$1" record path=""
  while IFS= read -r -d '' record; do
    case "$record" in
      "worktree "*) path="${record#worktree }" ;;
      "branch "*)
        if [ "$path" = "$want" ]; then
          printf '%s\n' "${record#branch refs/heads/}"
          return 0
        fi
        ;;
    esac
  done < <(git -C "$REPO_ROOT" worktree list --porcelain -z)
  return 0
}

# Print the git lock reason of a worktree, if it is locked.
worktree_lock_reason() {
  local want="$1" record path=""
  while IFS= read -r -d '' record; do
    case "$record" in
      "worktree "*) path="${record#worktree }" ;;
      locked*)
        if [ "$path" = "$want" ]; then
          local reason="${record#locked}"
          printf '%s\n' "${reason# }"
          return 0
        fi
        ;;
    esac
  done < <(git -C "$REPO_ROOT" worktree list --porcelain -z)
  return 0
}

# The primary checkout is a stable anchor for cleanup commands, even when
# this script runs from inside a linked worktree.
PRIMARY_ROOT="$(primary_checkout_path)"
[ -n "$PRIMARY_ROOT" ] || PRIMARY_ROOT="$REPO_ROOT"

# The worktree root derives from the primary checkout, so running the script
# from inside a linked worktree still targets the same parent directory.
REPO_PARENT=$(dirname "$PRIMARY_ROOT")

# ── Parse flags ────────────────────────────────────────────────
case "${1:-}" in
  --list|-l)
    header "Active worktrees"
    git -C "$REPO_ROOT" worktree list
    # `git worktree list` does not show the fork point; print the SHA spin
    # stamped for each checkout that has one.
    while IFS= read -r -d '' record; do
      case "$record" in
        "worktree "*) ;;
        *) continue ;;
      esac
      wt="${record#worktree }"
      if [ -f "$wt/.spin-base" ]; then
        base=$(<"$wt/.spin-base")
        printf '  %s  base %s\n' "$wt" "${base:0:12}"
      fi
    done < <(git -C "$REPO_ROOT" worktree list --porcelain -z)
    exit 0
    ;;
  --help|-h)
    echo "Usage: scripts/spin <branch-name> [--clean] [--no-install] [--no-seed-cache]"
    echo "       scripts/spin --list"
    echo ""
    echo "  <branch-name>   Feature branch name (e.g. feat/my-feature)"
    echo "  --clean          Remove the worktree and delete the branch"
    echo "  --no-install     Skip bun install in the new worktree"
    echo "  --no-seed-cache  Skip seeding .next/cache from the local snapshot"
    echo "  --list, -l       List all worktrees"
    echo ""
    echo "Worktrees are created directly in the repo's parent directory, one per"
    echo "branch, with '/' flattened to '-':"
    echo "  ../feat-my-feature   (branch feat/my-feature)"
    echo "  ../review-pr1377     (branch review/pr1377)"
    echo ""
    echo "SPIN_WORKTREE_ROOT=<absolute dir> relocates the root (same flattening),"
    echo "e.g. /tmp/builds/feat-my-feature."
    echo ""
    echo "Branches are cut from a freshly fetched origin/main (the last fetched"
    echo "origin/main when the fetch fails, local main when none is cached); the"
    echo "base commit is stamped into <worktree>/.spin-base and shown by --list."
    echo ""
    echo "--clean only removes worktrees that scripts/spin created."
    echo "It finds them by branch registration, not by path, so a worktree that"
    echo "has been moved is still the one cleaned."
    exit 0
    ;;
  "") fail "Missing branch name. Usage: scripts/spin <branch-name>" ;;
esac

BRANCH="$1"
CLEAN=false
NO_INSTALL=false
NO_SEED_CACHE=false
shift
for arg in "$@"; do
  case "$arg" in
    --clean) CLEAN=true ;;
    --no-install) NO_INSTALL=true ;;
    --no-seed-cache) NO_SEED_CACHE=true ;;
    *) fail "Unknown option: $arg" ;;
  esac
done

# ── Validate the branch name ───────────────────────────────────
if ! ref_error=$(git check-ref-format --branch "$BRANCH" 2>&1); then
  fail "Invalid branch name '$BRANCH': $ref_error"
fi

# ── Derive worktree path ───────────────────────────────────────
# One directory per branch, directly in the checkout's parent: the branch's
# slashes are flattened so a branch never adds nesting. SPIN_WORKTREE_ROOT
# relocates the root; the flattening is unchanged beneath it. Strip a trailing
# slash so no printed path has `//`; "/" itself must survive.
WORKTREE_ROOT="${SPIN_WORKTREE_ROOT:-${REPO_PARENT}}"
[ "$WORKTREE_ROOT" = "/" ] || WORKTREE_ROOT="${WORKTREE_ROOT%/}"
WORKTREE_DIR="$(printf '%s' "$BRANCH" | tr '/' '-')"
WORKTREE_PATH="${WORKTREE_ROOT}/${WORKTREE_DIR}"

# ── Clean mode ─────────────────────────────────────────────────
if $CLEAN; then
  header "Cleaning up worktree for '$BRANCH'"

  REGISTERED_PATH="$(worktree_path_for_branch "$BRANCH" || true)"

  if [ -n "$REGISTERED_PATH" ]; then
    if [ "$REGISTERED_PATH" = "$PRIMARY_ROOT" ]; then
      fail "Refusing to remove the primary checkout: $PRIMARY_ROOT"
    fi

    # Authorisation is the lock reason alone, never the path. The locator is
    # the branch registration, so the registered path is whatever git says it
    # is; recomputing the path and comparing would only re-derive the layout.
    lock_reason="$(worktree_lock_reason "$REGISTERED_PATH")"
    if [ "$lock_reason" != "$PROVENANCE_REASON" ]; then
      fail "Refusing to clean a worktree without scripts/spin provenance: $REGISTERED_PATH
  Expected lock reason \"$PROVENANCE_REASON\", found \"$lock_reason\".
  Left untouched. To remove it manually:
    git -C \"$PRIMARY_ROOT\" worktree remove -f -f \"$REGISTERED_PATH\"
    git -C \"$PRIMARY_ROOT\" branch -D -- \"$BRANCH\""
    fi

    if [ -d "$REGISTERED_PATH" ]; then
      # Two force flags: the provenance lock must survive a failed removal, so
      # remove the locked worktree directly instead of unlocking it first.
      if ! remove_error=$(git -C "$PRIMARY_ROOT" worktree remove --force --force "$REGISTERED_PATH" 2>&1); then
        fail "Could not remove worktree $REGISTERED_PATH: $remove_error"
      fi
      info "Removed worktree: $REGISTERED_PATH"
    else
      branch_sha="$(git -C "$PRIMARY_ROOT" rev-parse --quiet --verify "refs/heads/$BRANCH" 2>/dev/null || true)"
      warn "Worktree directory is missing: $REGISTERED_PATH"
      if [ -n "$branch_sha" ]; then
        warn "Branch '$BRANCH' is recoverable at ${branch_sha:0:12}; a directory moved outside git is not tracked, so its uncommitted work is not in that commit."
      fi
      # A locked registration is skipped by prune; drop the lock so the stale
      # entry can be pruned before the branch is deleted.
      if ! unlock_error=$(git -C "$PRIMARY_ROOT" worktree unlock "$REGISTERED_PATH" 2>&1); then
        fail "Could not unlock stale worktree $REGISTERED_PATH: $unlock_error"
      fi
    fi
  # No registration and no spin-provenance worktree: a directory at the path
  # this layout computes is only a hint, never a target. Removing it by path
  # would bypass the provenance check above.
  elif [ -d "$WORKTREE_PATH" ]; then
    if worktree_registered_at_path "$WORKTREE_PATH"; then
      occupant_branch="$(worktree_branch_at_path "$WORKTREE_PATH")"
      if [ -n "$occupant_branch" ]; then
        # Flattening maps feat/x onto feat-x; the directory is live and owned
        # by another branch, so it must never be presented as removable.
        warn "Found another branch's worktree at this path: $WORKTREE_PATH"
        warn "Branch '$occupant_branch' is checked out there; left untouched."
      else
        warn "Found a detached worktree at this path: $WORKTREE_PATH"
        warn "It is a registered worktree with no branch; left untouched."
      fi
      warn "Pick a different branch name, or relocate with SPIN_WORKTREE_ROOT=<dir>."
    else
      # No registration at all: the only case where removing the directory by
      # hand is true advice.
      warn "Found a directory that is not a registered worktree: $WORKTREE_PATH"
      warn "Left it untouched. Remove it manually, then re-run this command:"
      echo "    rm -rf \"$WORKTREE_PATH\""
    fi
  else
    warn "No worktree found for '$BRANCH' (expected $WORKTREE_PATH)"
  fi

  # Drop stale registrations before deleting the branch: a registration whose
  # directory is gone still marks the branch as checked out.
  if ! prune_error=$(git -C "$PRIMARY_ROOT" worktree prune 2>&1); then
    warn "Could not prune stale worktree entries: $prune_error"
  elif [ -n "$prune_error" ]; then
    info "Pruned stale worktree entries: $prune_error"
  else
    info "Pruned stale worktree entries"
  fi

  # Delete the branch if it exists
  if git -C "$PRIMARY_ROOT" branch --list -- "$BRANCH" | grep -q .; then
    if ! delete_error=$(git -C "$PRIMARY_ROOT" branch -D -- "$BRANCH" 2>&1); then
      warn "Could not delete branch '$BRANCH': $delete_error"
    else
      info "Deleted branch: $BRANCH"
    fi
  else
    warn "Branch '$BRANCH' does not exist"
  fi

  exit 0
fi

# Clean resolves by registration and provenance, so it never reads the root;
# validate the override only where a create will use it.
case "$WORKTREE_ROOT" in
  /*) ;;
  *) fail "SPIN_WORKTREE_ROOT must be an absolute path: $WORKTREE_ROOT" ;;
esac

# ── Preflight: the worktree root must be writable (create mode only) ──
# A root that exists as something other than a directory can never hold a
# worktree, and the ancestor walk below would walk straight past it.
if [ -e "$WORKTREE_ROOT" ] && [ ! -d "$WORKTREE_ROOT" ]; then
  fail "Cannot create a worktree: worktree root is not a directory: $WORKTREE_ROOT"
fi
# With SPIN_WORKTREE_ROOT set, the root may not exist yet; probe its nearest
# existing ancestor so a create fails before the branch is made.
PROBE_DIR="$WORKTREE_ROOT"
while [ ! -d "$PROBE_DIR" ] && [ "$PROBE_DIR" != "/" ]; do
  PROBE_DIR=$(dirname "$PROBE_DIR")
done
if [ ! -w "$PROBE_DIR" ] || [ ! -x "$PROBE_DIR" ]; then
  fail "Cannot create a worktree: parent directory is not writable: $PROBE_DIR"
fi
if ! probe_error=$(mktemp -d "${PROBE_DIR}/.spin-write-test.XXXXXX" 2>&1); then
  fail "Cannot create a worktree: parent directory is not writable: $PROBE_DIR ($probe_error)"
fi
rmdir "$probe_error" 2>/dev/null || true

# ── Check branch doesn't already exist ─────────────────────────
if git -C "$PRIMARY_ROOT" branch --list -- "$BRANCH" | grep -q .; then
  fail "Branch '$BRANCH' already exists. Use it directly or pick a different name."
fi

# ── Check worktree path doesn't already exist ──────────────────
# Flattening means two branch names can map to one directory (feat/x and
# feat-x), and a branch named after the repo maps to the primary checkout.
if [ -e "$WORKTREE_PATH" ]; then
  if [ "$WORKTREE_PATH" = "$PRIMARY_ROOT" ]; then
    fail "Directory already exists: $WORKTREE_PATH
  It is the primary checkout. Branch '$BRANCH' flattens to '$WORKTREE_DIR' under $WORKTREE_ROOT.
  Pick a different branch name."
  fi
  occupant="$(worktree_branch_at_path "$WORKTREE_PATH")"
  if [ -n "$occupant" ]; then
    detail="it is the checkout of branch '$occupant'"
  else
    detail="it is not a registered worktree"
  fi
  fail "Directory already exists: $WORKTREE_PATH
  Branch '$BRANCH' flattens to '$WORKTREE_DIR' under $WORKTREE_ROOT, and $detail.
  Pick a different branch name, or relocate with SPIN_WORKTREE_ROOT=<dir>."
fi

# ── Resolve the base commit ────────────────────────────────────
# Local main goes stale between fetches, and a branch cut from a stale main
# silently re-introduces work that has already merged. Prefer the remote ref.
# When the fetch fails (offline, or another worktree holding the ref lock), use
# the last fetched origin/main before local main: it is at least as new. One
# retry covers the common collision when several agents spin at once.
BASE_REF="main"
if git -C "$PRIMARY_ROOT" remote get-url origin >/dev/null 2>&1; then
  fetch_origin_main() {
    GIT_TERMINAL_PROMPT=0 git -C "$PRIMARY_ROOT" fetch --quiet origin \
      +refs/heads/main:refs/remotes/origin/main 2>&1
  }
  if fetch_error=$(fetch_origin_main); then
    BASE_REF="origin/main"
  else
    sleep 1
    if fetch_error=$(fetch_origin_main); then
      BASE_REF="origin/main"
    elif git -C "$PRIMARY_ROOT" rev-parse --quiet --verify "refs/remotes/origin/main^{commit}" >/dev/null 2>&1; then
      BASE_REF="origin/main"
      warn "Could not fetch origin/main; using the last fetched origin/main"
    else
      BASE_REF="main"
      warn "Could not fetch origin/main and none is cached; branching from local main"
    fi
    if [ -n "$fetch_error" ]; then
      warn "Fetch failed: $(redact_remote_error "$fetch_error")"
    fi
  fi
fi
if ! BASE_SHA=$(git -C "$PRIMARY_ROOT" rev-parse --quiet --verify "$BASE_REF^{commit}" 2>/dev/null); then
  fail "Could not resolve $BASE_REF to a commit in $PRIMARY_ROOT"
fi

# ── Create branch + worktree ───────────────────────────────────
header "Creating branch '$BRANCH' from $BASE_REF (${BASE_SHA:0:12})"
if ! branch_error=$(git -C "$PRIMARY_ROOT" branch -- "$BRANCH" "$BASE_SHA" 2>&1); then
  fail "Could not create branch '$BRANCH': $branch_error"
fi
info "Created branch '$BRANCH'"

header "Creating worktree"
WORKTREE_PARENT="$(dirname "$WORKTREE_PATH")"
if ! mkdir_error=$(mkdir -p "$WORKTREE_PARENT" 2>&1); then
  git -C "$PRIMARY_ROOT" branch -D -- "$BRANCH" >/dev/null 2>&1 || true
  fail "Could not create worktree directory: $WORKTREE_PARENT: $mkdir_error (branch '$BRANCH' was deleted)"
fi
if ! add_error=$(git -C "$PRIMARY_ROOT" worktree add "$WORKTREE_PATH" "$BRANCH" 2>&1); then
  git -C "$PRIMARY_ROOT" branch -D -- "$BRANCH" >/dev/null 2>&1 || true
  fail "Could not create worktree at $WORKTREE_PATH: $add_error (branch '$BRANCH' was deleted)"
fi
if ! lock_error=$(git -C "$PRIMARY_ROOT" worktree lock --reason "$PROVENANCE_REASON" "$WORKTREE_PATH" 2>&1); then
  git -C "$PRIMARY_ROOT" worktree remove "$WORKTREE_PATH" --force >/dev/null 2>&1 || true
  git -C "$PRIMARY_ROOT" branch -D -- "$BRANCH" >/dev/null 2>&1 || true
  fail "Could not record worktree provenance at $WORKTREE_PATH: $lock_error (worktree and branch '$BRANCH' were rolled back)"
fi
info "Worktree ready at $WORKTREE_PATH"

# The stamp is how later tooling (and the reviewer) learns the intended base
# even after origin/main has moved on. Stamping is part of the contract, but a
# failure warns rather than discarding an otherwise usable worktree.
if printf '%s\n' "$BASE_SHA" > "$WORKTREE_PATH/.spin-base"; then
  info "Stamped base $BASE_REF at ${BASE_SHA:0:12}"
else
  warn "Could not write $WORKTREE_PATH/.spin-base (base $BASE_REF at $BASE_SHA)"
fi

# ── Install dependencies in the fresh worktree ─────────────────
# A fresh worktree has no node_modules, and the first pre-commit hook fails
# without them. Install here so the blessed path is ready to work; a failed
# install warns instead of rolling the worktree back (offline is not fatal).
if $NO_INSTALL; then
  info "Skipping dependency install (--no-install)"
elif [ ! -f "$WORKTREE_PATH/bun.lock" ]; then
  info "No bun.lock in the worktree; skipping dependency install"
elif ! command -v bun >/dev/null 2>&1; then
  warn "bun not found; run 'bun install --frozen-lockfile' in $WORKTREE_PATH"
else
  header "Installing dependencies"
  if ! install_error=$(cd "$WORKTREE_PATH" && bun install --frozen-lockfile 2>&1); then
    warn "Dependency install failed in $WORKTREE_PATH"
    printf '%s\n' "$install_error" >&2
    warn "Run: cd \"$WORKTREE_PATH\" && bun install --frozen-lockfile"
  else
    info "Dependencies installed"
  fi
fi

# ── Seed the Turbopack build cache (ADR-0014) ──────────────────
# Best-effort and optional: a snapshot that does not match this branch, a full
# disk or a refused cache root leaves the worktree cold and never blocks it. The
# seed runs from THIS checkout's script (the new branch was cut from origin/main,
# which may not carry the cache code yet) and targets the new worktree.
if $NO_SEED_CACHE; then
  info "Skipping build-cache seed (--no-seed-cache)"
elif [ "${STUDIQ_CACHE_SEED:-1}" = "0" ]; then
  info "Skipping build-cache seed (STUDIQ_CACHE_SEED=0)"
elif [ ! -d "$WORKTREE_PATH/node_modules/next" ]; then
  info "Skipping build-cache seed (dependencies are not installed)"
elif [ ! -f "$REPO_ROOT/scripts/env/seed-cache.ts" ]; then
  warn "Skipping build-cache seed ($REPO_ROOT/scripts/env/seed-cache.ts not found)"
else
  header "Seeding the Turbopack build cache"
  if seed_output=$(cd "$WORKTREE_PATH" && bun "$REPO_ROOT/scripts/env/seed-cache.ts" "$WORKTREE_PATH" 2>&1); then
    info "$seed_output"
  else
    warn "Build-cache seed skipped: $seed_output"
  fi
fi

# ── Summary ────────────────────────────────────────────────────
header "Done"
echo ""
printf "  Branch:   ${CYAN}%s${NC}\n" "$BRANCH"
printf "  Worktree: ${CYAN}%s${NC}\n" "$WORKTREE_PATH"
printf "  Base:     ${CYAN}%s${NC} @ %s\n" "$BASE_REF" "${BASE_SHA:0:12}"
echo ""
echo "  Next steps:"
echo "    1. cd \"$WORKTREE_PATH\""
echo "    2. Open an agent session in the worktree"
echo "    3. When done: scripts/spin $BRANCH --clean"
echo ""
