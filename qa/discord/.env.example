# ── Discord server ────────────────────────────────────────────────────────
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# ── Manager bot ───────────────────────────────────────────────────────────
DISCORD_MANAGER_TOKEN=
DISCORD_MANAGER_CHANNEL_ID=
DISCORD_DASHBOARD_CHANNEL_ID=

# ── Env bots ──────────────────────────────────────────────────────────────
DISCORD_ENV1_TOKEN=
DISCORD_ENV1_CHANNEL_ID=
DISCORD_ENV2_TOKEN=
DISCORD_ENV2_CHANNEL_ID=
DISCORD_ENV3_TOKEN=
DISCORD_ENV3_CHANNEL_ID=
DISCORD_ENV4_TOKEN=
DISCORD_ENV4_CHANNEL_ID=

# ── Env bots 5-8 ──────────────────────────────────────────────────────────
DISCORD_ENV5_TOKEN=
DISCORD_ENV5_CHANNEL_ID=
DISCORD_ENV6_TOKEN=
DISCORD_ENV6_CHANNEL_ID=
DISCORD_ENV7_TOKEN=
DISCORD_ENV7_CHANNEL_ID=
DISCORD_ENV8_TOKEN=
DISCORD_ENV8_CHANNEL_ID=

# ── Overseer bot (optional 10th bot) ────────────────────────────────────
# Create a separate Discord application/bot, enable Message Content Intent,
# invite it to the guild, and put it in #overseer with View/Send/History.
DISCORD_OVERSEER_TOKEN=
DISCORD_OVERSEER_CHANNEL_ID=
QA_FIX_OVERSEER_STATE=/workspaces/studiq/.qa-fix/overseer.json

# ── StudiQ QA integration ─────────────────────────────────────────────────
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_PASSWORD=studiq-local-dev
DASHBOARD_URL=http://127.0.0.1:5000
QA_LIVE_ROOT=/workspaces/studiq/.worktrees/qa-env
QA_MANAGER_TOOL=/workspaces/studiq/.worktrees/qa-env/qa/tools/qa-manager.py
QA_MANAGER_PROMPT=/workspaces/studiq/.worktrees/qa-env/qa/MANAGER-PROMPT.md
BROWSER_CLI=/workspaces/studiq/.worktrees/qa-env/dashboard/browser-cli.ts
SHOTS_DIR=/workspaces/studiq/.worktrees/qa-env/dashboard/shots

# ── Behaviour ─────────────────────────────────────────────────────────────
DISCORD_DRY_RUN=1
DISCORD_STATUS_MS=15000
DISCORD_LOG_LEVEL=info
