#!/usr/bin/env bash
# Run Playwright against the current QA slot without a per-slot temp config.
# Usage (from the slot root, or with --env qa-env-N):
#   bun qa/tools/qa-playwright [playwright args...]
set -euo pipefail

CONFIG=/workspaces/studiq/.worktrees/qa-env/qa/fixtures/playwright.config.ts
if [ -z "${PLAYWRIGHT_BASE_URL:-}" ]; then
  if [ -n "${APP_URL:-}" ]; then
    export PLAYWRIGHT_BASE_URL="$APP_URL"
  elif [ -f qa/env.json ]; then
    export PLAYWRIGHT_BASE_URL="$(python3 -c 'import json; print(json.load(open("qa/env.json"))["appUrl"])')"
  else
    export PLAYWRIGHT_BASE_URL="http://localhost:3000"
  fi
fi

exec bunx playwright test --config "$CONFIG" "$@"
