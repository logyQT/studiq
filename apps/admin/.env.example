# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Admin PEM gate — JSON keyring (single-quoted so dotenv keeps the JSON intact).
#
# Each entry: { id, key, scopes[], expiresAt? }
#   id        unique, non-empty — the identity recorded in the audit log
#   key       base64 DER SPKI Ed25519 public key
#   scopes    explicit allow-list; `:write` implies `:read`; `users:purge` is separate.
#             Known scopes: organizations:read, feature-flags:read|write,
#             plan-features:read|write, plan-limits:read|write,
#             subscription-plans:read|write, user-overrides:read|write,
#             users:read|write|purge
#   expiresAt optional ISO-8601 date/datetime; an expired key authenticates to 401
#
# Generate an entry (and its private key) with:
#   bun scripts/admin-sign.ts gen --id ops-local --scopes feature-flags:read,users:read
#
# Empty = dev bypass in non-production, deny-all in production. A non-empty value
# that parses to zero valid entries fails closed in every environment.
ADMIN_PEM_KEYS=
